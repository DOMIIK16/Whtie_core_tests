<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Dashboard</title>
    <link rel="icon" type="image/png" href="../images/favicon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300..700;1,300..700&family=Teachers:ital,wght@0,400..800;1,400..800&display=swap"
      rel="stylesheet"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300..700;1,300..700&display=swap"
      rel="stylesheet"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300..700;1,300..700&family=JetBrains+Mono:ital,wght@0,100..800;1,100..800&family=Teachers:ital,wght@0,400..800;1,400..800&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="css/user-page.css" />
  </head>
  <body>
    <section class="header">
      <div class="header-content-parent-container">
        <div class="white-core-heading">
          <img
            class="white-core-small-icon drop"
            src="../images/white-core-small-img.png"
            alt="White Core Logo"
          />
          <h2 class="White-core-heading-text">White Core</h2>
        </div>
      </div>
    </section>

    <div class="side-pane">
      <div class="dashboard option">
        <p class="option-text">Dashboard</p>
      </div>

      <div class="settings option">
        <p class="option-text">Settings</p>
      </div>
    </div>

    <section class="dashboard-main page active">
      <div class="dashboard-section">
        <section class="first-section-content-parent">
          <div class="personal-info-container">
            <p class="tier-badge">★</p>

            <article class="personal-info-text-container">
              <h1 class="header-text">User name</h1>

              <div class="league-text-container">
                <p class="tier-label">Member</p>
              </div>

              <p class="ref-points-to-go-texts">
                You can earn 60% of your referral's registration fee.
              </p>
            </article>
          </div>

          <div class="box-container">
            <div class="box">
              <div class="box-content-container">
                <div class="box-heading-container">
                  <p class="box-heading-texts">Total earnings</p>
                </div>

                <div class="bal-image-container">
                  <div class="box-sample-image-contanier">
                    <img
                      src="../images/earnings-icon.png"
                      class="box-sample-image"
                    />
                  </div>

                  <p class="bal-text">0.00</p>
                </div>
                <div class="more-options-container">
                  <p class="more-options-txt">Withdraw</p>
                </div>
              </div>
            </div>

            <div class="box">
              <div class="box-content-container">
                <div class="box-heading-container">
                  <p class="box-heading-texts">Referral Count</p>
                </div>

                <div class="referral-container-image">
                  <div class="box-sample-image-contanier">
                    <img
                      src="../images/referral-count-icon.png"
                      class="box-sample-image"
                    />
                  </div>

                  <p class="referral-count-text">0</p>
                </div>
                <div class="more-options-container">
                  <p class="more-options-txt">View</p>
                </div>
              </div>
            </div>
          </div>
        </section>

        <section class="referral-options-container">
          <div class="box">
            <div class="referral-options-container-content">
              <div class="box-heading-container">
                <p class="box-heading-texts">Referral link</p>
              </div>

              <div class="referral-method-txt-container">
                <p class="referral-method-txt">Lorem ipsum</p>
              </div>

              <div class="more-options-container">
                <p class="more-options-txt">Copy</p>
              </div>
            </div>
          </div>
          <div class="box">
            <div class="referral-options-container-content">
              <div class="box-heading-container">
                <p class="box-heading-texts">Referral Code</p>
              </div>

              <div class="referral-method-txt-container">
                <p class="referral-method-txt">lorem-ipsum</p>
              </div>

              <div class="more-options-container">
                <p class="more-options-txt">Copy</p>
              </div>
            </div>
          </div>

          <div class="box">
            <div class="referral-options-container-content">
              <div class="box-heading-container">
                <p class="box-heading-texts">Invite Contacts</p>
              </div>

              <div class="referral-method-txt-container">
                <p class="referral-method-txt">lorem-ipsum</p>
              </div>

              <div class="more-options-container">
                <p class="more-options-txt">Share</p>
              </div>
            </div>
          </div>
        </section>

        <section class="leadership-board-container">
          <div class="leadershipboard-box"></div>
        </section>
      </div>
    </section>

    <section class="settings-main page">
      <div class="settings-section">
        <div class="personal-info-parent-container settings-box">
          <div class="settings-box-header">
            <h1 class="header-text">Personal Information</h1>
          </div>
          <div class="personal-info-content-container">
            <div class="personal-info-content">
              <div class="personal-info-row">
                <div class="info-box">
                  <div class="info-heading-container">
                    <p class="info-heading">Username</p>
                  </div>
                  <div class="info-text-container">
                    <p class="info-text">Domi112</p>
                  </div>
                  <div class="change-container modify">
                    <p class="change-text">Change</p>
                  </div>
                </div>
                <div class="info-box">
                  <div class="info-heading-container">
                    <p class="info-heading">Name</p>
                  </div>
                  <div class="info-text-container">
                    <p class="info-text">Ikwuka Dominion</p>
                  </div>
                  <div class="change-container modify">
                    <p class="change-text">Change</p>
                  </div>
                </div>
              </div>
              <div class="personal-info-row">
                <div class="info-box">
                  <p class="info-heading">Tier Plan</p>
                  <p class="info-text">Tier 2</p>
                </div>
                <div class="info-box">
                  <p class="info-heading">Alliance</p>
                  <p class="info-text">Alliance Name</p>
                </div>
              </div>
            </div>
            <div class="profile-picture-parent-container">
              <div class="user-profile-picture-container">
                <img
                  src="../images/profile-icon.png"
                  alt=""
                  class="user-profile-picture"
                />
              </div>
              <div class="update-container modify">
                <p class="update-text">Update</p>
              </div>
            </div>
          </div>
        </div>

        <div class="account-settings-parent-container settings-box">
          <div class="settings-box-header">
            <h1 class="header-text">Account Settings</h1>
          </div>
          <div class="account-settings-content-container">
            <div class="account-settings-container">
              <div class="account-settings change-password-container">
                <p class="settings-text">Change Password</p>
              </div>
              <div class="account-settings update-withdrawal-account-container">
                <p class="settings-text">Update Withdrawal account</p>
              </div>
              <div class="account-settings change-email-container">
                <p class="settings-text">Change Email</p>
              </div>
            </div>
            <div class="tier-plan-parent-container">
              <div class="tier-plan-sample-image-container">
                <img
                  src="../images/tier-2-silver.png"
                  class="tier-plan-sample-image"
                />
              </div>
              <div class="tier-upgrade-container modify">
                <p class="tier-upgrade-text">Upgrade</p>
              </div>
            </div>
          </div>
        </div>
        <div class="session-parent-container settings-box">
          <div class="settings-box-header">
            <h1 class="header-text">Session</h1>
          </div>
          <div class="session-content-container">
            <div class="session-setting">
              <p class="logout-text">Logout</p>
            </div>
            <div class="delete-account-container">
              <p class="delete-account-text">Delete Account</p>
            </div>
          </div>
        </div>
      </div>
      <section class="change-settings-container pop-up">
        <div class="change-settings-parent-container">
          <div class="change-settings-content-container">
            <div class="x-container">
              <p class="x-text">X</p>
            </div>
            <div class="change-setting-container">
              <div class="place-holder-text-container">Ikwuka Dominion</div>
              <div class="new-change-container" contenteditable="true">
                Username
              </div>
              <div class="new-change-container" contenteditable="true">
                Confirm username
              </div>
              <div class="submit-container">
                <p class="submit-text">Submit</p>
              </div>
            </div>
          </div>
        </div>
      </section>
    </section>

    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script src="js/user-page.js"></script>
  </body>
</html>
