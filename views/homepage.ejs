<!doctype html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>White Core</title>
  <link rel="icon" type="image/png" href="images/favicon.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300..700;1,300..700&family=Teachers:ital,wght@0,400..800;1,400..800&display=swap" rel="stylesheet" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300..700;1,300..700&display=swap" rel="stylesheet" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Charm:wght@400;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="css/homepage.css" />
</head>

<body>
  <section class="header">
    <div class="header-content-parent-container">
      <div class="white-core-heading">
        <img class="white-core-small-icon" src="images/white-core-small-img.png" alt="White Core Logo" />
        <h2 class="White-core-heading-text">White Core</h2>
      </div>

      <div class="user-actions-container">
        <form action="/register" method="GET">
          <button class="get-started-btn register top-get-started-btn">
            <p class="get-started-btn-txt">Get Started</p>
          </button>
        </form>
      </div>
    </div>
  </section>

  <section class="hero-section">
    <div class="hero-section-parent-container">
      <div class="hero-txts-container">
        <div class="get-paid-to-container">
          <div class="get-paid-to-txt-container">
            <p class="get-paid-to-txt">Get-Paid-To-Platform</p>
          </div>
        </div>

        <div class="hero-heading-txt-container">
          <h1 class="hero-heading-txt">
            Refer friends and earn massive rewards
          </h1>
          <p class="sub-txt">
            Earn up to 70% referral bonus for each friend you invite. The more
            referrals you collect, the more rewards you get.
          </p>
        </div>

        <div class="mother-company-container">
          <div class="powered-by-container">
            <span class="powered-by-txt">Powered by:</span>
            <span class="company-name">Vyntra</span>
          </div>
        </div>
      </div>

      <div class="hero-section-images-container">
        <div class="sample-images-container">
          <div class="wallet-image-container">
            <img src="images/wallet.png" alt="" class="wallet" />
          </div>

          <div class="sample-image-set-2">
            <div class="referral-image-container">
              <img src="images/referral.jpeg" alt="" class="referral" />
            </div>

            <div class="analysis-image-container">
              <img src="images/analysis.png" alt="" class="analysis" />
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="start-up-section">
    <div class="section-heading-container">
      <p class="micro-heading-txt">START UP</p>
      <h1 class="section-heading-txt">
        Your Referral Journey - Maximize Your
        <span class="tier-earnings-txt-spaned"> Tier Earnings. </span>
      </h1>
    </div>

    <div class="steps-parent-container">
      <div class="step">
        <div class="step-illustration-img-container register-img-container">
          <img src="images/register-illustration-img.png" alt="" class="step-illustration-img" />
        </div>

        <div class="step-explaination-container">
          <p class="step-heading-txt">Registration</p>
          <p class="body-txt">
            Please provide your complete personal details below. This
            information is strictly required to verify your identity and
            ensure the security of your account.
          </p>
        </div>
      </div>

      <div class="step middle-step">
        <div class="step-illustration-img-container middle-step-img">
          <img src="images/payment-illustration-img.png" alt="" class="step-illustration-img" />
        </div>

        <div class="step-explaination-container middle-step-txt">
          <p class="step-heading-txt">Payment</p>
          <p class="body-txt">
            Successfully process your registration fee to secure your spot and
            begin your journey. We look forward to helping you get started.
          </p>
        </div>
      </div>

      <div class="step">
        <div class="step-explaination-container">
          <p class="step-heading-txt">Refer!</p>
          <p class="body-txt">
            Share your referral link with friends and unlock rewards tailored
            to your membership tier.
          </p>
        </div>
        <div class="step-illustration-img-container start-refering-img-container">
          <img src="images/start-refering-illustration-img.png" alt="" class="step-illustration-img" />
        </div>
      </div>
    </div>

    <form action="/register" method="GET">
      <button class="get-started-btn register">
        <p class="get-started-btn-txt">Get Started</p>
      </button>
    </form>
  </section>

  <section class="tier-plan-details-section">
    <div class="section-heading-container">
      <p class="micro-heading-txt">TIER PLAN DETAILS</p>
      <h1 class="section-heading-txt">Detailed Benefits Of Our Tier Plans</h1>
      <p class="sub-txt">
        The more you refer, the more you earn explore the benefits and rewards
        of each tier.
      </p>
    </div>
    <div class="tier-accordion">
      <article class="tier-card">
        <div class="tier-toggle">
          <p class="tier-badge">★</p>

          <div class="tier-heading">
            <p class="tier-name">Tier 1</p>
            <p class="tier-label">Member</p>
          </div>

          <div class="tier-rate">
            <p class="rate-label">EARNING RATE</p>
            <p class="rate-value">60%</p>
          </div>
        </div>
        <div class="tier-details">
          <div class="tier-column">
            <h3>Benefits</h3>
            <ul>
              <li>Access to Leadership Boards.</li>
              <li>60% referral commission.</li>
              <li>Referral Documentation.</li>
              <li>Referral Activity Tracking.</li>
            </ul>
          </div>
          <div class="tier-column">
            <h3>Requirements</h3>
            <ul>
              <li>Fill personal details.</li>
              <li>Pay registration fee.</li>
              <li>Start referring.</li>
            </ul>
          </div>
        </div>
      </article>

      <article class="tier-card">
        <div class="tier-toggle">
          <p class="tier-badge silver">♛</p>
          <div class="tier-heading">
            <p class="tier-name">Tier 2</p>
            <p class="tier-label">Silver</p>
          </div>
          <div class="tier-rate">
            <p class="rate-label">EARNING RATE</p>
            <p class="rate-value">70%</p>
          </div>
        </div>
        <div class="tier-details">
          <div class="tier-column">
            <h3>Benefits</h3>
            <ul>
              <li>Higher priority on the leadership boards.</li>
              <li>Higher earning rate (10% increase).</li>
              <li>Eye-catching referral documentation.</li>
              <li>Referral Activity Tracking.</li>
            </ul>
          </div>
          <div class="tier-column">
            <h3>Requirements</h3>
            <ul>
              <li>Fill personal details.</li>
              <li>Pay registration fee (Tier 2).</li>
              <li>Start referring.</li>
            </ul>
          </div>
        </div>
      </article>
    </div>
    <div class="tier-footer">
      <span class="footer-icon">◇</span>
      <p>
        All tiers come with secure payments, real-time tracking, and
        transparent rewards.
      </p>
    </div>
  </section>

  <section class="buttom-container">
    <article class="buttom-container-content-container">
      <div class="buttom-container-stay-connected-container">
        <h2 class="section-heading-txt">STAY CONNECTED</h2>
        <div class="buttom-container-stay-connected-body-txt-container">
          <p class="body-txt">
            Follow us on our social media platforms and stay updated with
            latest news, offers, and announcements.
          </p>
        </div>
      </div>

      <div class="buttom-container-a-container">
        <a href="https://web.facebook.com/profile.php?id=61596446614907" class="homepage-link-text">FaceBook</a>
        <a href="https://www.instagram.com/vyntra.whitecore?mdxt=MWttZzFraHNhOGN2Nw==" class="homepage-link-text">Instagram</a>
        <a href="https://www.tiktok.com/@vyntra.whitecore?_r=1&_t=ZS-9BNbB6zFFfJ" class="homepage-link-text">TikTok</a>
        <a href="http://localhost:3000/feedback" class="homepage-link-text">Email Us</a>
      </div>

      <div class="built-on-trust-container">
        <p class="built-on-trust-txt">
          <em>"Built on trust, Driven by vision"</em>
        </p>
      </div>

      <div class="footer-container">
        <p class="footer-txt">@2026 WHITE CORE.</p>
        <p class="footer-txt">|</p>
        <img class="white-core-small-icon" src="images/white-core-small-img-2.png" alt="" />
        <p class="footer-txt">|</p>
        <p class="footer-txt">All Rights Reserved.</p>
      </div>
    </article>
  </section>
  <script src="js/homepage.js"></script>
</body>

</html>